# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_NAME=KhrishaEnterprisesCRM
# FRONTEND_URL=http://localhost:3000
FRONTEND_URL=https://khrishacrm.vasifytech.com,https://akuabeat.com

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=krishna_crm
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ─── Integration Tokens ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v19.0

# ─── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
ALLOWED_CSV_MIME=text/csv,application/vnd.ms-excel,text/plain

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=logs

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
